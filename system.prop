dalvik.vm.heapgrowthlimit=92m
dalvik.vm.heapsize=196m
dalvik.vm.lockprof.threshold=500
dalvik.vm.stack-trace-dir=/data/anr
dalvik.vm.systemservercompilerfilter=speed-profile
debug.hwui.render_dirty_regions=false
mediatek.wlan.ctia=0
net.bt.name=Android
persist.panel.orientation=90
persist.service.adb.enable=1
persist.sys.dalvik.vm.lib.2=libart.so
persist.sys.timezone=Asia/Shanghai
qemu.hw.mainkeys=1
rild.libargs=-d /dev/ttyC0
rild.libpath=mtk-ril.so
ro.audio.silent=0
ro.bionic.ld.warning=1
ro.boot.rotation_after_logo=0
ro.boot.selinux=disable
ro.camera.sound.forced=0
ro.config.media_vol_default=12
ro.expect.recovery_id=0x1da0bcfde4e4c950fc6463109b827c40c55be62c000000000000000000000000
ro.kernel.zio=38,108,105,16
ro.mediatek.wlan.p2p=1
ro.mediatek.wlan.wsc=1
ro.opengles.version=196610
ro.product.cpu.abi2=armeabi
ro.sys.usb.bicr=no
ro.sys.usb.charging.only=yes
ro.sys.usb.mtp.whql.enable=0
ro.sys.usb.storage.type=mtp
ro.tether.denied=true
ro.wifi.channels=
ro.zygote.preload.enable=0
service.adb.tcp.port=5555
sys.ipo.disable=1
sys.ipo.pwrdncap=2
wifi.direct.interface=p2p0
wifi.interface=wlan0
wifi.tethering.interface=ap0
